generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODEL
// ============================================
model User {
  id       String     @id @default(uuid())
  email    String     @unique
  name     String?
  password String
  serial   String
  status   UserStatus @default(PENDING)

  verificationCodes VerificationCode[]
  enrollments       Enrollment[]
  progress          Progress[]
  quizAttempts      QuizAttempt[]
  reviews           Review[]
  purchases         Purchase[]
  usedPurchaseCodes PurchaseCode[]
  basketItems       BasketItem[]
  notifications     Notification[]
  courseQuestions   CourseQuestion[]
  courseAnswers     CourseAnswer[]
  contentNotes      ContentNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([email])
  @@index([serial])
}

model Admin {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String?
  password String

  verificationCodes VerificationCode[]
  purchaseCodes     PurchaseCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([email])
}

model VerificationCode {
  id        String   @id @default(uuid())
  userId    String?
  adminId   String?
  code      String
  purpose   String
  expiresAt DateTime

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, purpose], name: "userId_purpose")
  @@index([userId])
  @@index([adminId])
  @@index([code])
  @@index([expiresAt])
}

// ============================================
// INSTRUCTOR MODEL
// ============================================
model Instructor {
  id     String  @id @default(uuid())
  name   String // e.g., "Dr. Ahlam Said"
  email  String? @unique
  avatar String? // Profile picture URL
  bio    String? @db.Text
  title  String? // e.g., "PhD in Computer Science"

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([email])
}

// ============================================
// CATEGORY MODEL
// ============================================
model Category {
  id          String  @id @default(uuid())
  name        String  @unique // Design, Medical, Arts, etc.
  slug        String  @unique
  description String?
  icon        String? // Icon URL or identifier

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([slug])
}

// ============================================
// COURSE MODEL
// ============================================
model Course {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  description String  @db.Text
  thumbnail   String? // Course image/thumbnail

  // Instructor
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id])

  // Category
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Pricing
  price            Float     @default(0)
  discountPrice    Float? // Discounted price if any
  discountExpiresAt DateTime? // When the discount expires (null = no expiry)

  // Course meta
  totalDuration Int @default(0) // Total duration in minutes
  totalVideos   Int @default(0)
  totalQuizzes  Int @default(0)

  // Learning outcomes - stored as JSON array of bullet strings
  learningOutcomes Json? // e.g. ["Build real Flutter apps", "Master state management"]

  // Status
  status      CourseStatus @default(DRAFT)
  isPublished Boolean      @default(false)

  sections      Section[]
  enrollments   Enrollment[]
  reviews       Review[]
  purchaseCodes PurchaseCode[]
  purchases     Purchase[]
  basketItems   BasketItem[]
  questions     CourseQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([instructorId])
  @@index([categoryId])
  @@index([slug])
  @@index([isPublished])
}

// ============================================
// SECTION MODEL (Sections within a course)
// ============================================
model Section {
  id    String @id @default(uuid())
  title String // e.g., "Section 1.0"
  order Int // Order of section in course

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  contents Content[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([courseId, order])
}

// ============================================
// CONTENT MODEL (Videos, PDFs, Quizzes)
// ============================================
model Content {
  id       String      @id @default(uuid())
  title    String // e.g., "lec 1: introduction to IOT fundamentals"
  type     ContentType // VIDEO, PDF, QUIZ
  order    Int // Order within section
  duration Int? // Duration in minutes (for videos/quizzes)

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // For Videos
  videoUrl String?

  // For PDFs
  pdfUrl   String?
  fileSize Int? // File size in bytes

  // For Quizzes
  quiz Quiz?

  progress      Progress[]
  purchaseCodes PurchaseCode[]
  purchases     Purchase[]
  notes         ContentNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([sectionId, order])
}

enum ContentType {
  VIDEO
  PDF
  QUIZ
}

enum CourseStatus {
  DRAFT          // Just created, no sections yet
  SECTIONS_ADDED // Sections added
  CONTENT_ADDED  // Content added
  QUIZ_ADDED     // Quiz added (complete)
  PUBLISHED      // Published to users
}

// ============================================
// QUIZ MODEL
// ============================================
model Quiz {
  id        String  @id @default(uuid())
  contentId String  @unique
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  timeLimit    Int? // Time limit in minutes
  passingScore Int  @default(70) // Percentage required to pass

  questions Question[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ============================================
// QUESTION MODEL
// ============================================
model Question {
  id     String @id @default(uuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  questionText String @db.Text
  order        Int // Question order in quiz
  points       Int    @default(1)

  options     Option[]
  userAnswers UserAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([quizId])
  @@index([order])
}

// ============================================
// OPTION MODEL (Multiple choice answers)
// ============================================
model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text      String
  isCorrect Boolean @default(false)
  order     Int // Display order

  userAnswers UserAnswer[]

  createdAt DateTime @default(now())

  @@index([questionId])
}

// ============================================
// ENROLLMENT MODEL (User enrollment in courses)
// ============================================
model Enrollment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  status   EnrollmentStatus @default(ONGOING)
  progress Int              @default(0) // Overall Course Progress -- Percentage (0-100)

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

enum EnrollmentStatus {
  ONGOING
  COMPLETED
  SAVED
}

// ============================================
// PROGRESS MODEL (Track content completion)
// ============================================
model Progress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  completed   Boolean   @default(false) // ← Tracks each video/PDF/quiz completion
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

// ============================================
// QUIZ ATTEMPT MODEL
// ============================================
model QuizAttempt {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  score     Int // Percentage score
  passed    Boolean @default(false)
  timeTaken Int? // Time taken in seconds

  userAnswers UserAnswer[]

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([quizId])
}

// ============================================
// USER ANSWER MODEL (Track answers in quiz attempts)
// ============================================
model UserAnswer {
  id        String      @id @default(uuid())
  attemptId String
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionId String?
  selectedOption   Option? @relation(fields: [selectedOptionId], references: [id])

  isCorrect Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([attemptId])
  @@index([questionId])
}

// ============================================
// REVIEW MODEL (Course reviews and ratings)
// ============================================
model Review {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  rating  Float // 1-5 stars
  comment String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, courseId]) // One review per user per course
  @@index([userId])
  @@index([courseId])
  @@index([rating])
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

// ============================================
// PURCHASE CODE MODEL (One-time purchase codes)
// ============================================
model PurchaseCode {
  id   String       @id @default(uuid())
  code String       @unique // The actual purchase code (e.g., "COURSE-ABC123")
  type PurchaseType // COURSE or VIDEO

  // What the code is for
  courseId  String? // If type is COURSE
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contentId String? // If type is VIDEO
  content   Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  // Usage tracking
  isUsed Boolean   @default(false)
  usedBy String? // User ID who used the code
  user   User?     @relation(fields: [usedBy], references: [id], onDelete: SetNull)
  usedAt DateTime?

  // Code metadata
  expiresAt DateTime? // Optional expiration date
  maxUses   Int       @default(1) // Default: one-time use (can be changed for multi-use codes)
  usedCount Int       @default(0) // Track how many times it's been used

  // Admin who created the code
  createdBy String
  admin     Admin  @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([code])
  @@index([isUsed])
  @@index([type])
  @@index([courseId])
  @@index([contentId])
  @@index([createdBy])
}

// ============================================
// PURCHASE MODEL (User purchases)
// ============================================
model Purchase {
  id   String       @id @default(uuid())
  type PurchaseType // COURSE or VIDEO

  // User who made the purchase
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What was purchased
  courseId  String? // If type is COURSE
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contentId String? // If type is VIDEO
  content   Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  // Purchase code used
  purchaseCodeId String
  purchaseCode   PurchaseCode @relation(fields: [purchaseCodeId], references: [id], onDelete: Cascade)

  purchasedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, courseId, type]) // Prevent duplicate course purchases
  @@unique([userId, contentId, type]) // Prevent duplicate video purchases
  @@index([userId])
  @@index([courseId])
  @@index([contentId])
  @@index([purchaseCodeId])
}

enum PurchaseType {
  COURSE
  VIDEO
}

// ============================================
// BASKET MODEL (Shopping cart for courses)
// ============================================
model BasketItem {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, courseId]) // Prevent duplicate items in basket
  @@index([userId])
  @@index([courseId])
}

// ============================================
// NOTIFICATION MODEL (User notifications)
// ============================================
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  icon        String? // Icon identifier (star, alert, info, etc.)
  title       String
  description String?          @db.Text
  data        Json? // Additional data (courseId, etc.)

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  PROMO // Promotional offers
  REMINDER // Course reminders
  NEW_COURSE // New courses available
  ACHIEVEMENT // User achievements
  SYSTEM // System notifications
}

// ============================================
// Q&A — Course-level threads anchored to a course
// ============================================
model CourseQuestion {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title String
  body  String @db.Text

  answers CourseAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([courseId, createdAt])
  @@index([userId])
}

model CourseAnswer {
  id         String @id @default(uuid())
  questionId String
  question   CourseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body           String  @db.Text
  isInstructor   Boolean @default(false) // marks answers from the course instructor/admin

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([questionId, createdAt])
  @@index([userId])
}

// ============================================
// Notes — per-user per-content free-form notes
// ============================================
model ContentNote {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  body String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, contentId]) // one note per (user, content)
  @@index([userId])
  @@index([contentId])
}
