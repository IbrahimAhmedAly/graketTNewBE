generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODEL
// ============================================
model User {
  id       String     @id @default(uuid())
  email    String     @unique
  name     String?
  password String
  serial   String
  status   UserStatus @default(PENDING)

  // Education targeting — student picks a level, then a grade within it.
  // Nullable so pre-existing users keep working; new users supply both.
  educationLevelId String?
  educationLevel   EducationLevel? @relation(fields: [educationLevelId], references: [id])
  gradeId          String?
  grade            Grade?          @relation(fields: [gradeId], references: [id])

  // Guardian contact, used only for parent-facing progress reports.
  // Nullable: existing students have none, and it is never required to learn.
  parentPhone String?

  // Set on every successful login. Distinct from updatedAt, which moves on any
  // profile write and is therefore useless as a "last seen" signal.
  lastLoginAt DateTime?

  verificationCodes VerificationCode[]
  enrollments       Enrollment[]
  progress          Progress[]
  quizAttempts      QuizAttempt[]
  reviews           Review[]
  purchases         Purchase[]
  usedPurchaseCodes PurchaseCode[]
  basketItems       BasketItem[]
  notifications     Notification[]
  courseQuestions   CourseQuestion[]
  courseAnswers     CourseAnswer[]
  contentNotes      ContentNote[]

  // Activity tracking — the raw signal behind every reported statistic.
  videoWatchProgress VideoWatchProgress[]
  contentViews       ContentView[]
  studySessions      StudySession[]
  dailyActivity      DailyActivity[]
  stats              StudentStats?
  badges             StudentBadge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([email])
  @@index([serial])
  @@index([educationLevelId])
  @@index([gradeId])
  @@index([lastLoginAt])
}

model Admin {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String?
  password String

  verificationCodes VerificationCode[]
  purchaseCodes     PurchaseCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([email])
}

model VerificationCode {
  id        String   @id @default(uuid())
  userId    String?
  adminId   String?
  code      String
  purpose   String
  expiresAt DateTime

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, purpose], name: "userId_purpose")
  @@index([userId])
  @@index([adminId])
  @@index([code])
  @@index([expiresAt])
}

// ============================================
// INSTRUCTOR MODEL
// ============================================
model Instructor {
  id     String  @id @default(uuid())
  name   String // e.g., "Dr. Ahlam Said"
  email  String? @unique
  avatar String? // Profile picture URL
  bio    String? @db.Text
  title  String? // e.g., "PhD in Computer Science"

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([email])
}

// ============================================
// CATEGORY MODEL
// ============================================
model Category {
  id          String  @id @default(uuid())
  name        String  @unique // Design, Medical, Arts, etc.
  slug        String  @unique
  description String?
  icon        String? // Icon URL or identifier

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([slug])
}

// ============================================
// EDUCATION LEVEL MODEL (University, Middle School, Primary School)
// Students pick a level first, then a grade within it.
// ============================================
model EducationLevel {
  id    String @id @default(uuid())
  name  String @unique // "University", "Middle School", "Primary School"
  order Int    @default(0) // Display order in the level picker

  grades  Grade[]
  users   User[]
  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([order])
}

// ============================================
// GRADE MODEL (Year / grade within an education level)
// e.g. "Year 1" under University, "Grade 7" under Middle School
// ============================================
model Grade {
  id    String @id @default(uuid())
  name  String // "Year 1", "Grade 7", ...
  order Int    @default(0) // Display order within the level

  educationLevelId String
  educationLevel   EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)

  users   User[]
  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([educationLevelId, name]) // no duplicate grade names within a level
  @@index([educationLevelId])
  @@index([order])
}

// ============================================
// COURSE MODEL
// ============================================
model Course {
  id          String  @id @default(uuid())
  title       String
  slug        String  @unique
  description String  @db.Text
  thumbnail   String? // Course image/thumbnail

  // Instructor
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id])

  // Category
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  // Education targeting.
  // educationLevelId: which level the course is for (nullable for legacy rows).
  // gradeId: the specific grade, or null for a course aimed at the whole level.
  educationLevelId String?
  educationLevel   EducationLevel? @relation(fields: [educationLevelId], references: [id])
  gradeId          String?
  grade            Grade?          @relation(fields: [gradeId], references: [id])

  // Pricing
  price             Float     @default(0)
  discountPrice     Float? // Discounted price if any
  discountExpiresAt DateTime? // When the discount expires (null = no expiry)

  // Course meta
  totalDuration Int @default(0) // Total duration in minutes
  totalVideos   Int @default(0)
  totalQuizzes  Int @default(0)

  // Learning outcomes - stored as JSON array of bullet strings
  learningOutcomes Json? // e.g. ["Build real Flutter apps", "Master state management"]

  // Status
  status      CourseStatus @default(DRAFT)
  isPublished Boolean      @default(false)

  sections      Section[]
  enrollments   Enrollment[]
  reviews       Review[]
  purchaseCodes PurchaseCode[]
  purchases     Purchase[]
  basketItems   BasketItem[]
  questions     CourseQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([instructorId])
  @@index([categoryId])
  @@index([educationLevelId])
  @@index([gradeId])
  @@index([slug])
  @@index([isPublished])
}

// ============================================
// SECTION MODEL (Sections within a course)
// ============================================
model Section {
  id    String @id @default(uuid())
  title String // e.g., "Section 1.0"
  order Int // Order of section in course

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  contents Content[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([courseId, order])
}

// ============================================
// CONTENT MODEL (Videos, PDFs, Quizzes)
// ============================================
model Content {
  id       String      @id @default(uuid())
  title    String // e.g., "lec 1: introduction to IOT fundamentals"
  type     ContentType // VIDEO, PDF, QUIZ
  order    Int // Order within section
  duration Int? // Duration in minutes (for videos/quizzes)

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // For Videos
  videoUrl String?

  // For PDFs
  pdfUrl   String?
  fileSize Int? // File size in bytes

  // For Quizzes
  quiz Quiz?

  progress      Progress[]
  purchaseCodes PurchaseCode[]
  purchases     Purchase[]
  notes         ContentNote[]

  watchProgress VideoWatchProgress[]
  views         ContentView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([sectionId, order])
}

enum ContentType {
  VIDEO
  PDF
  QUIZ
}

enum CourseStatus {
  DRAFT // Just created, no sections yet
  SECTIONS_ADDED // Sections added
  CONTENT_ADDED // Content added
  QUIZ_ADDED // Quiz added (complete)
  PUBLISHED // Published to users
}

// ============================================
// QUIZ MODEL
// ============================================
model Quiz {
  id        String  @id @default(uuid())
  contentId String  @unique
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  timeLimit    Int? // Time limit in minutes
  passingScore Int  @default(70) // Percentage required to pass

  questions Question[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ============================================
// QUESTION MODEL
// ============================================
model Question {
  id     String @id @default(uuid())
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  questionText String @db.Text
  order        Int // Question order in quiz
  points       Int    @default(1)

  // Optional concept tag ("Integration", "Magnetism"). Drives weak-topic
  // analysis; when null, reporting falls back to grouping by lesson.
  topic String?

  options     Option[]
  userAnswers UserAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([quizId])
  @@index([order])
}

// ============================================
// OPTION MODEL (Multiple choice answers)
// ============================================
model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text      String
  isCorrect Boolean @default(false)
  order     Int // Display order

  userAnswers UserAnswer[]

  createdAt DateTime @default(now())

  @@index([questionId])
}

// ============================================
// ENROLLMENT MODEL (User enrollment in courses)
// ============================================
model Enrollment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  status   EnrollmentStatus @default(ONGOING)
  progress Int              @default(0) // Overall Course Progress -- Percentage (0-100)

  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

enum EnrollmentStatus {
  ONGOING
  COMPLETED
  SAVED
}

// ============================================
// PROGRESS MODEL (Track content completion)
// ============================================
model Progress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  completed   Boolean   @default(false) // ← Tracks each video/PDF/quiz completion
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
}

// ============================================
// QUIZ ATTEMPT MODEL
// ============================================
model QuizAttempt {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  score     Int // Percentage score
  passed    Boolean @default(false)
  timeTaken Int? // Time taken in seconds

  userAnswers UserAnswer[]

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([quizId])
}

// ============================================
// USER ANSWER MODEL (Track answers in quiz attempts)
// ============================================
model UserAnswer {
  id        String      @id @default(uuid())
  attemptId String
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionId String?
  selectedOption   Option? @relation(fields: [selectedOptionId], references: [id])

  isCorrect Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([attemptId])
  @@index([questionId])
}

// ============================================
// REVIEW MODEL (Course reviews and ratings)
// ============================================
model Review {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  rating  Float // 1-5 stars
  comment String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, courseId]) // One review per user per course
  @@index([userId])
  @@index([courseId])
  @@index([rating])
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

// ============================================
// PURCHASE CODE MODEL (One-time purchase codes)
// ============================================
model PurchaseCode {
  id   String       @id @default(uuid())
  code String       @unique // The actual purchase code (e.g., "COURSE-ABC123")
  type PurchaseType // COURSE or VIDEO

  // What the code is for
  courseId  String? // If type is COURSE
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contentId String? // If type is VIDEO
  content   Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  // Usage tracking
  isUsed Boolean   @default(false)
  usedBy String? // User ID who used the code
  user   User?     @relation(fields: [usedBy], references: [id], onDelete: SetNull)
  usedAt DateTime?

  // Code metadata
  expiresAt DateTime? // Optional expiration date
  maxUses   Int       @default(1) // Default: one-time use (can be changed for multi-use codes)
  usedCount Int       @default(0) // Track how many times it's been used

  // Admin who created the code
  createdBy String
  admin     Admin  @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([code])
  @@index([isUsed])
  @@index([type])
  @@index([courseId])
  @@index([contentId])
  @@index([createdBy])
}

// ============================================
// PURCHASE MODEL (User purchases)
// ============================================
model Purchase {
  id   String       @id @default(uuid())
  type PurchaseType // COURSE or VIDEO

  // User who made the purchase
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What was purchased
  courseId  String? // If type is COURSE
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contentId String? // If type is VIDEO
  content   Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  // Purchase code used
  purchaseCodeId String
  purchaseCode   PurchaseCode @relation(fields: [purchaseCodeId], references: [id], onDelete: Cascade)

  purchasedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, courseId, type]) // Prevent duplicate course purchases
  @@unique([userId, contentId, type]) // Prevent duplicate video purchases
  @@index([userId])
  @@index([courseId])
  @@index([contentId])
  @@index([purchaseCodeId])
}

enum PurchaseType {
  COURSE
  VIDEO
}

// ============================================
// BASKET MODEL (Shopping cart for courses)
// ============================================
model BasketItem {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, courseId]) // Prevent duplicate items in basket
  @@index([userId])
  @@index([courseId])
}

// ============================================
// NOTIFICATION MODEL (User notifications)
// ============================================
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  icon        String? // Icon identifier (star, alert, info, etc.)
  title       String
  description String?          @db.Text
  data        Json? // Additional data (courseId, etc.)

  isRead Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  PROMO // Promotional offers
  REMINDER // Course reminders
  NEW_COURSE // New courses available
  ACHIEVEMENT // User achievements
  SYSTEM // System notifications
}

// ============================================
// Q&A — Course-level threads anchored to a course
// ============================================
model CourseQuestion {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title String
  body  String @db.Text

  answers CourseAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([courseId, createdAt])
  @@index([userId])
}

model CourseAnswer {
  id         String         @id @default(uuid())
  questionId String
  question   CourseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  body         String  @db.Text
  isInstructor Boolean @default(false) // marks answers from the course instructor/admin

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([questionId, createdAt])
  @@index([userId])
}

// ============================================
// Notes — per-user per-content free-form notes
// ============================================
model ContentNote {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  body String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, contentId]) // one note per (user, content)
  @@index([userId])
  @@index([contentId])
}

// ============================================
// Legal Documents — Privacy Policy & Terms and Conditions
// Single row per type, edited in place by admins, read publicly.
// Bilingual (Arabic + English) rich-text (HTML) bodies.
// ============================================
model LegalDocument {
  id String @id @default(uuid())

  type LegalDocumentType @unique // one document per type

  // Bilingual rich-text (HTML) bodies produced by the dashboard editor
  contentAr String @db.Text
  contentEn String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([type])
}

enum LegalDocumentType {
  PRIVACY_POLICY
  TERMS_AND_CONDITIONS
}

// ============================================
// BANNER MODEL (Home-screen marketing banners)
// ============================================
model Banner {
  id       String  @id @default(uuid())
  image    String // S3 public image URL
  isActive Boolean @default(true) // Only active banners show in the app

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive])
}

// ════════════════════════════════════════════════════════════════════════
//  ACTIVITY TRACKING
//
//  These models are the raw signal behind every reported statistic. The
//  reporting layer only ever aggregates what is recorded here — it never
//  estimates. If a number cannot be derived from these tables, it is not
//  shown.
// ════════════════════════════════════════════════════════════════════════

/// Per-video watch state. `watchedSeconds` is the measure of the *union* of
/// segments actually played, so seeking to the end does not mark a video
/// watched; the merge happens in the service before this row is written.
model VideoWatchProgress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  /// Union of watched intervals, in seconds. Never exceeds durationSec.
  watchedSeconds Int @default(0)

  /// Where playback stopped, for resume. Not a progress measure — a student
  /// can be at 00:10 having already watched the whole video.
  lastPositionSec Int @default(0)

  /// Reported by the player, not admin-entered, so watchPercent is real.
  /// Null until the first event carries it.
  durationSec Int?

  /// Materialized watchedSeconds/durationSec so leaderboards and course
  /// rollups avoid recomputing across every row on read.
  watchPercent Int @default(0)

  /// Increments when playback restarts after reaching the end.
  replayCount Int @default(0)

  /// Merged, sorted, non-overlapping [start, end] pairs in seconds.
  /// Kept so later events extend a true union rather than a running total.
  segments Json?

  firstWatchedAt DateTime  @default(now())
  lastWatchedAt  DateTime  @default(now())
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@index([userId, lastWatchedAt])
}

/// One row per open of any content item. Unlike Progress (a single terminal
/// boolean), this preserves repeat opens, which is what "how many times did
/// they reopen this file" reports actually need.
model ContentView {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  type ContentType

  /// Foreground time on this item, in seconds.
  durationSec Int @default(0)

  /// PDF read depth, from the viewer's page callbacks. Null for other types.
  pagesRead  Int?
  totalPages Int?

  openedAt DateTime  @default(now())
  closedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([contentId])
  @@index([userId, openedAt])
  @@index([userId, type])
}

/// An app-foreground study session, opened on launch/resume and closed on
/// background or by the idle sweep. Sessions are the only source for
/// "study hours" — a metric that silently inflates if a backgrounded app is
/// left counting, hence the explicit heartbeat and server-side timeout.
model StudySession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startedAt       DateTime  @default(now())
  lastHeartbeatAt DateTime  @default(now())
  endedAt         DateTime?

  /// Elapsed seconds, finalized when the session closes.
  durationSec Int @default(0)

  /// Seconds already added to the daily rollup while the session was running.
  ///
  /// Study time is credited incrementally on each heartbeat so a session in
  /// progress shows up today rather than only after it closes. Recording what
  /// has been banked is what makes that safe: every credit adds only the
  /// difference since the last one, so heartbeats, a client-sent end and the
  /// idle sweep can all run over the same session without counting a second
  /// twice.
  creditedSec Int @default(0)

  /// Minutes offset from UTC on the device. Required to bucket a session into
  /// the student's own calendar day: a 21:00 session in Cairo belongs to that
  /// day, not to UTC's next one.
  tzOffsetMinutes Int @default(0)

  /// False once closed by the idle sweep rather than by the client.
  closedByClient Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([userId, startedAt])
  @@index([endedAt])
}

/// Per-student, per-local-day rollup. Written on ingest so the heat map and
/// weekly chart are indexed range scans rather than aggregations over every
/// raw event, and so day-bucketing happens in exactly one place.
model DailyActivity {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The student's LOCAL calendar day (date-only, no time component).
  date DateTime @db.Date

  studySeconds  Int @default(0)
  videosWatched Int @default(0)

  /// Seconds of video genuinely played today (union-merged, so scrubbing does
  /// not count).
  ///
  /// Distinct from `videosWatched`, which only counts videos crossing the 90%
  /// completion bar. On a two-hour lecture a student can study hard for an hour
  /// and still finish no video, so completions alone make a real day of work
  /// look like an empty one.
  videoSeconds Int @default(0)

  quizzesTaken  Int @default(0)
  pdfsOpened    Int @default(0)
  contentsDone  Int @default(0)
  pointsEarned  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([userId, date])
  @@index([date])
}

/// Denormalized per-student totals. Recomputed on ingest so the dashboard,
/// ranking, and Success Index do not each re-derive them.
model StudentStats {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalPoints       Int @default(0)
  totalStudySeconds Int @default(0)

  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime? @db.Date

  /// 0-100. Null until there is enough activity to compute it honestly —
  /// a fresh account shows "not enough data", never a red 0.
  successIndex   Int?
  successIndexAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([totalPoints])
  @@index([successIndex])
}

/// Catalogue of earnable badges. Seeded, admin-extensible.
model Badge {
  id          String @id @default(uuid())
  code        String @unique
  name        String
  description String
  icon        String

  /// Machine-readable unlock rule, e.g. { "type": "streak", "threshold": 7 }.
  criteria Json

  points Int @default(0)

  isActive Boolean @default(true)

  students StudentBadge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive])
}

/// Join row recording that a student earned a badge, and when.
model StudentBadge {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@index([userId, earnedAt])
}
